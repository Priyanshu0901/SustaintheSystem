 void zb_ncp::on_rx_data(const void* data,size_t size) {
+#if CONFIG_COORDINATOR_STATUS_UI
+    // Optional framed UI extension; no radio calls or unframed serial traffic.
+    if (size >= sizeof(cmd_t)) {
+        const cmd_t& cmd = *static_cast<const cmd_t*>(data);
+        if (cmd.type == REQUEST) {
+            uint8_t out[sizeof(cmd_t) + 32];
+            size_t n = coordinator_ui_command(static_cast<uint16_t>(cmd.command_id),
+                static_cast<const uint8_t*>(data) + sizeof(cmd_t), size - sizeof(cmd_t),
+                out + sizeof(cmd_t), 32);
+            if (n) {
+                memcpy(out, data, sizeof(cmd_t));
+                out[1] = RESPONSE;
+                send_cmd_data(out, sizeof(cmd_t) + n);
+                return;
+            }
+        }
+    }
+#endif
+
