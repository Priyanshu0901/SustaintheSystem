# Active board: Waveshare ESP32-C6-Touch-LCD-1.9, 8 MB.
# USB carries framed NCP traffic; parallel UART and text logs are disabled.
CONFIG_NCP_BUS_MODE_USB=y
CONFIG_NCP_UART_TRANSPORT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# Use the same reviewed LVGL configuration on firmware and native tests.
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
