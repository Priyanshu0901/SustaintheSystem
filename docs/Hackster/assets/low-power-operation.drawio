        </mxCell>
        <mxCell id="acq" value="&lt;b&gt;Capture an audio window&lt;/b&gt;&lt;br&gt;Start acquisition&lt;br&gt;Fill aligned sample buffers" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#9eb1c3;fontColor=#173249;fontSize=19;spacing=12;" parent="1" vertex="1">
