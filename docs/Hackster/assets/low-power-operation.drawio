        </mxCell>
        <mxCell id="init" value="&lt;b&gt;Initialize once&lt;/b&gt;&lt;br&gt;Load model and allocate buffers" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#9eb1c3;fontColor=#173249;fontSize=19;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="210" width="350" height="95" as="geometry" />
        </mxCell>
        <mxCell id="wait" value="&lt;b&gt;Wait for scheduled work&lt;/b&gt;&lt;br&gt;Next capture timer&lt;br&gt;Service scheduled radio events" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#e6f5ef;strokeColor=#9eb1c3;fontColor=#173249;fontSize=19;spacing=12;" parent="1" vertex="1">
