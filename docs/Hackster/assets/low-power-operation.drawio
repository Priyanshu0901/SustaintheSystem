        </mxCell>
        <mxCell id="send" value="&lt;b&gt;Transmit report&lt;/b&gt;&lt;br&gt;Queued event or periodic status" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#9eb1c3;fontColor=#173249;fontSize=19;spacing=12;" parent="1" vertex="1">
